services:
  jobdock-server:
    image: "@@JOBDOCK_SERVER_REFERENCE@@"
    restart: unless-stopped
    ports:
      - "${JOBDOCK_HTTP_PORT:-8080}:8080"
    environment:
      JOBDOCK_LISTEN_ADDR: ":8080"
      JOBDOCK_PUBLIC_URL: "${JOBDOCK_PUBLIC_URL:-http://localhost:8080}"
      JOBDOCK_ALLOW_INSECURE_HTTP: "${JOBDOCK_ALLOW_INSECURE_HTTP:-true}"
      JOBDOCK_BOOTSTRAP_ADMIN_USERNAME: "${JOBDOCK_BOOTSTRAP_ADMIN_USERNAME:-admin}"
      JOBDOCK_BOOTSTRAP_ADMIN_PASSWORD: "${JOBDOCK_BOOTSTRAP_ADMIN_PASSWORD:?Set a bootstrap password of at least 12 characters}"
      JOBDOCK_TELEMETRY_RAW_RETENTION: "${JOBDOCK_TELEMETRY_RAW_RETENTION:-24h}"
      JOBDOCK_TELEMETRY_RETENTION: "${JOBDOCK_TELEMETRY_RETENTION:-720h}"
      JOBDOCK_MAX_INPUT_BYTES: "${JOBDOCK_MAX_INPUT_BYTES:-10737418240}"
      JOBDOCK_BUILD_ANALYSIS_TIMEOUT: "${JOBDOCK_BUILD_ANALYSIS_TIMEOUT:-2m}"
      JOBDOCK_BUILDER_TOKEN: "${JOBDOCK_BUILDER_TOKEN:?Set a random builder token of at least 32 characters}"
      JOBDOCK_BUILDER_LEASE: "${JOBDOCK_BUILDER_LEASE:-30s}"
      JOBDOCK_MAX_BUILD_ARTIFACT_BYTES: "${JOBDOCK_MAX_BUILD_ARTIFACT_BYTES:-21474836480}"
      JOBDOCK_BUILD_ARTIFACT_RETENTION: "${JOBDOCK_BUILD_ARTIFACT_RETENTION:-720h}"
    volumes:
      - jobdock-data:/var/lib/jobdock
    read_only: true
    tmpfs:
      - /tmp:rw,exec,size=512m,mode=1777
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "/usr/local/bin/jobdock-server", "--healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      - default
      - builder-control

  jobdock-builder:
    image: "@@JOBDOCK_BUILDER_REFERENCE@@"
    restart: unless-stopped
    depends_on:
      jobdock-server:
        condition: service_healthy
      buildkitd:
        condition: service_healthy
    environment:
      JOBDOCK_SERVER_URL: "http://jobdock-server:8080"
      JOBDOCK_ALLOW_INSECURE_HTTP: "true"
      JOBDOCK_BUILDER_TOKEN: "${JOBDOCK_BUILDER_TOKEN:?Set a random builder token of at least 32 characters}"
      JOBDOCK_BUILDKIT_ADDRESS: "tcp://buildkitd:1234"
      JOBDOCK_BUILDER_LEASE: "${JOBDOCK_BUILDER_LEASE:-30s}"
      JOBDOCK_BUILD_TIMEOUT: "${JOBDOCK_BUILD_TIMEOUT:-30m}"
      JOBDOCK_MAX_INPUT_BYTES: "${JOBDOCK_MAX_INPUT_BYTES:-10737418240}"
      JOBDOCK_MAX_BUILD_ARTIFACT_BYTES: "${JOBDOCK_MAX_BUILD_ARTIFACT_BYTES:-21474836480}"
      JOBDOCK_RAILPACK_FRONTEND: "${JOBDOCK_RAILPACK_FRONTEND:-ghcr.io/railwayapp/railpack-frontend:v0.36.0}"
    volumes:
      - jobdock-builder-data:/var/lib/jobdock-builder
    read_only: true
    tmpfs:
      - /tmp:size=64m,mode=1777
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    networks:
      - builder-control
      - builder-backend

  buildkitd:
    image: moby/buildkit:v0.30.0-rootless
    restart: unless-stopped
    command:
      - --addr
      - tcp://0.0.0.0:1234
      - --oci-worker-no-process-sandbox
      - --oci-worker-gc
      - --oci-worker-gc-keepstorage
      - "${JOBDOCK_BUILD_CACHE_LIMIT_MB:-20480}"
    environment:
      BUILDKITD_FLAGS: ""
    volumes:
      - jobdock-buildkit-data:/home/user/.local/share/buildkit
    cpus: "${JOBDOCK_BUILD_CPU_LIMIT:-2.0}"
    mem_limit: "${JOBDOCK_BUILD_MEMORY_LIMIT:-4g}"
    pids_limit: ${JOBDOCK_BUILD_PID_LIMIT:-1024}
    security_opt:
      - seccomp:unconfined
      - apparmor:unconfined
    healthcheck:
      test: ["CMD", "buildctl", "--addr", "tcp://127.0.0.1:1234", "debug", "workers"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 5s
    networks:
      - builder-backend

volumes:
  jobdock-data:
  jobdock-builder-data:
  jobdock-buildkit-data:

networks:
  builder-control:
    internal: true
  builder-backend:
