JOBDOCK_LISTEN_ADDR=:8080
JOBDOCK_DATA_DIR=/var/lib/jobdock
JOBDOCK_DATABASE_PATH=/var/lib/jobdock/jobdock.db
JOBDOCK_ALLOW_INSECURE_HTTP=true
JOBDOCK_BOOTSTRAP_ADMIN_USERNAME=admin
JOBDOCK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
JOBDOCK_PUBLIC_URL=http://localhost:8080
JOBDOCK_TELEMETRY_RAW_RETENTION=24h
JOBDOCK_TELEMETRY_RETENTION=720h
