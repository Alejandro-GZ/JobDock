JOBDOCK_LISTEN_ADDR=:8080
JOBDOCK_DATA_DIR=/var/lib/jobdock
JOBDOCK_DATABASE_PATH=/var/lib/jobdock/jobdock.db
JOBDOCK_ALLOW_INSECURE_HTTP=true
JOBDOCK_BOOTSTRAP_ADMIN_USERNAME=admin
JOBDOCK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
JOBDOCK_PUBLIC_URL=http://localhost:8080
JOBDOCK_HTTP_PORT=8080
JOBDOCK_MAX_INPUT_BYTES=10737418240
JOBDOCK_BUILD_ANALYSIS_TIMEOUT=2m
JOBDOCK_RAILPACK_BINARY=railpack
JOBDOCK_BUILDER_TOKEN=replace-with-a-random-token-of-at-least-32-characters
JOBDOCK_BUILDER_LEASE=30s
JOBDOCK_BUILD_TIMEOUT=30m
JOBDOCK_BUILD_CPU_LIMIT=2.0
JOBDOCK_BUILD_MEMORY_LIMIT=4g
JOBDOCK_BUILD_PID_LIMIT=1024
JOBDOCK_BUILD_CACHE_LIMIT_MB=20480
JOBDOCK_MAX_BUILD_ARTIFACT_BYTES=21474836480
JOBDOCK_BUILD_ARTIFACT_RETENTION=720h
JOBDOCK_RAILPACK_FRONTEND=ghcr.io/railwayapp/railpack-frontend:v0.36.0
JOBDOCK_TELEMETRY_RAW_RETENTION=24h
JOBDOCK_TELEMETRY_RETENTION=720h
